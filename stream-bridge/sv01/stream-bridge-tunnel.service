# systemd unit for sv01 — maintains the reverse tunnel to the Fly stream
# bridge. Install at /etc/systemd/system/stream-bridge-tunnel.service
#
#   sudo apt install -y autossh
#   sudo cp stream-bridge-tunnel.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now stream-bridge-tunnel
#
[Unit]
Description=Reverse tunnel: sv01 HLS proxy -> vGreens stream bridge (Fly)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N \
  -o ServerAliveInterval=15 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=accept-new \
  -o IdentitiesOnly=yes \
  -i /root/.ssh/stream_bridge_ed25519 \
  -p 22 \
  -R '*:8090:127.0.0.1:8090' \
  tunnel@vgreens-stream-bridge.fly.dev
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
