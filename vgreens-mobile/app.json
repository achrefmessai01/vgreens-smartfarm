{
  "expo": {
    "name": "vGreens",
    "slug": "vgreens-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "vgreens",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#016f7c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vgreens.smartfarm"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#016f7c"
      },
      "package": "com.vgreens.smartfarm",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b231e713-84bd-4bb1-a19e-9d6713c7d4ca"
      }
    },
    "owner": "bangash11",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b231e713-84bd-4bb1-a19e-9d6713c7d4ca"
    }
  }
}
